# Optional settings for `gaime host` / `npm run host` on this machine (copy to .env).
# Everything is documented in docs/DEPLOYMENT.md.

# GAIME_MODE=live            # live (Vite + HMR) or release (production builds)
# GAIME_PORT=5173
# GAIME_BRANCH=main
# GAIME_GATES=auto           # auto | none | check,test
# GAIME_ALLOWED_HOSTS=my-laptop.tailnet.ts.net
# GAIME_PUBLIC_URL=https://game.example.com
# GAIME_LATENCY_MS=120       # simulated server round trip for testing
