{
  "name": "@gaime/physics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rigid-body physics for gaime games (Rapier 2D): the world stays plain JSON, the physics world is a derived resource.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "vitest run --root ../.. packages/physics",
    "bench": "GAIME_BENCH=1 vitest run --root ../.. packages/physics/tests/bench --reporter=verbose"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0"
  },
  "peerDependencies": {
    "@gaime/core": "*"
  }
}
