# /srv/gaime/<game>/.env — written by deploy/install.sh, edit and `docker compose up -d`.

# Directory name in games/ and the public domain.
GAME=starter
DOMAIN=starter.example.com

# live    = Vite + HMR on the server: pushes land in seconds, no restart (default)
# release = production build per commit, short restart, static gateway keeps pages up
GAIME_MODE=live

# Checks run before a commit goes live: "auto" (live: typecheck, release: none),
# "none", or a list of npm scripts, e.g. "check,test".
GAIME_GATES=auto
GAIME_BRANCH=main
GAIME_POLL_MS=3000

# Optional fixed token for `gaime admin` / the operator API (otherwise generated in data/admin-token).
# GAIME_ADMIN_TOKEN=

# HTTPS: pick one.
COMPOSE_FILE=compose.yml:compose.traefik.yml
# COMPOSE_FILE=compose.yml:compose.caddy.yml
# COMPOSE_FILE=compose.yml            (own proxy on the host → 127.0.0.1:8080)

# Traefik (compose.traefik.yml)
EDGE_NETWORK=edge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Where the gateway listens on the host (compose.yml). Use a different port per game.
GATEWAY_BIND=127.0.0.1:8080
