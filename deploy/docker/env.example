# /srv/gaime/<game>/.env — written by deploy/install.sh, edit and `docker compose up -d`.

# Directory name in games/ and the public domain.
GAME=starter
DOMAIN=starter.example.com

# live    = Vite + HMR on the server: pushes land in seconds, no restart (default)
# release = production build per commit, short restart, static gateway keeps pages up
GAIME_MODE=live

# Checks run before a commit goes live: "auto" (live: typecheck, release: none),
# "none", or a list of npm scripts, e.g. "check,test".
GAIME_GATES=auto
GAIME_BRANCH=main
GAIME_POLL_MS=3000

# Optional supervisor/server settings (empty or unset = default).
# GAIME_REMOTE=origin              # git remote to follow
# GAIME_SOAK_MS=2500               # how long a new version must stay healthy before it counts as good
# GAIME_START_TIMEOUT_MS=120000    # waiting for the game process to answer /health
# GAIME_HMR_TIMEOUT_MS=30000       # live mode: waiting for a hot reload to report the new version
# GAIME_SERVER_ENTRY=src/server/index.ts
# GAIME_ALLOWED_HOSTS=             # extra Vite host names, comma separated (live mode)
# GAIME_LATENCY_MS=                # simulated round trip for testing, never in production

# Optional fixed token for `gaime admin` / the operator API (otherwise generated in data/admin-token).
# GAIME_ADMIN_TOKEN=

# Matches mode (rooms: { mode: 'matches' }, docs/ROOMS.md).
# GAIME_EMPTY_ROOM_SECONDS=30      # an empty match closes after this long
# GAIME_MAX_ROOMS=1000             # new matches are refused beyond this many rooms

# Scaling out (matches mode, GAIME_MODE=release): several game processes sharing rooms through Redis.
# Add compose.redis.yml to COMPOSE_FILE below; docs/DEPLOYMENT.md "Scaling out".
# GAIME_PROCESSES=4
# GAIME_REDIS_URL=redis://redis:6379

# HTTPS: pick one.
COMPOSE_FILE=compose.yml:compose.traefik.yml
# COMPOSE_FILE=compose.yml:compose.caddy.yml
# COMPOSE_FILE=compose.yml            (own proxy on the host → 127.0.0.1:8080)
# COMPOSE_FILE=compose.yml:compose.traefik.yml:compose.redis.yml   (+ several processes, see above)

# Traefik (compose.traefik.yml)
EDGE_NETWORK=edge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Where the gateway listens on the host (compose.yml). Use a different port per game.
GATEWAY_BIND=127.0.0.1:8080
